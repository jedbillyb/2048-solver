# Tunables for evolve131.sh - re-read every loop iteration. ENABLED=0 to pause.

ENABLED=1

# Phase 1 (harvest 65536 boards by playing FROM 32768 seeds):
TARGET_BOARDS=12          # lowered 20->12: observed harvest ~0.6-1%/game (5,0,0 over last 3
                          # chunks), slower than the 1.8% historical, so 20 was ~a day out.
                          # USER GOAL (stated twice) is the 65536->131072 CONVERSION, so get
                          # into Phase 2 sooner. 12 distinct seeds * RESTART_P 0.9 = ~19k
                          # restart-games/board/gen = plenty of signal to PROVE conversion
                          # learning works. If it works, RAISE this for generalization.
                          # This is the floor; do not keep lowering - change approach instead.
GEN_COUNT=64              # positions kept-target per chunk (tries = 4x = 256 games);
                          # large so the ~90s five8 load amortizes over a ~1h chunk
GEN_FROM_FILE=          # EMPTY = fresh full games (no --from-file). pos32k seeds gave
                        # 0 boards over ~1600 games at depth 5 AND 6; the historical ~1.8%
                        # rate of reaching 65536 only shows up in fresh games, not from seeds.
GEN_ENDGAME_DEPTH=6       # macroxue endgame search depth from rank 15 (raised 5->6:
                          # depth-5 gave 0/832 from pos32k seeds; depth-6 matches the
                          # config behind the historical ~1.8%. Slower per game.
GEN_LAYOUTS=block10,five8 # BOTH tables = the historical ~1.8% config. five8-only gave 0
                          # over ~512 fresh games; block10 added after freeing the idle,
                          # loopback-only farm (killed 2026-10-10). ~13GB tables+net; the
                          # 3800 guard still protects production.

# Phase 2 (train the 65536 -> 131072 conversion):
GAMES=250000              # games per generation (~45min)
FREEZE=3                  # freeze stages 0-2 (whole early/mid game); train only stage 3
RESTART_P=0.9             # 90% of games restart from a seeded 65536 board...
RESTART_STAGE=3           # ...pulled from the stage-3 keys (the pos65k seeds)
EVAL_N=6                  # fixed eval subset size (131072% measured on these); half the
                          # 12-board library so Phase 2 can begin as soon as we hit TARGET

GEN_SLEEP=5
RAM_FLOOR_MB=3800         # production floor; child killed if available RAM drops below
                          # (raised from 3000 for five8's anonymous-heap footprint)
