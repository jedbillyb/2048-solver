# Tunables for evolve131.sh - re-read every loop iteration. ENABLED=0 to pause.

ENABLED=1

# Phase 1 (grow the 65536 board library):
TARGET_BOARDS=40      # stop growing and start training once pos65k.txt has this many
GEN_COUNT=16          # positions kept-target per chunk (tries = 4x this)
GEN_ENDGAME_DEPTH=5   # macroxue endgame search depth from rank 15 (deeper = more reach, slower)
GEN_LAYOUTS=block10   # endgame table(s) to load (block10=3GB fits; five8=7.8GB breaches RAM floor)

# Phase 2 (train the 65536 -> 131072 conversion):
GAMES=250000          # games per generation (~45min)
FREEZE=3              # freeze stages 0-2 (whole early/mid game); train only stage 3
RESTART_P=0.9         # 90% of games restart from a seeded 65536 board...
RESTART_STAGE=3       # ...pulled from the stage-3 keys (the pos65k seeds)
EVAL_N=20             # fixed eval subset size (131072% measured on these)

GEN_SLEEP=5
RAM_FLOOR_MB=3000     # production floor; child killed if free RAM drops below
