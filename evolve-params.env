# Tunables for evolve.sh - re-read at the start of every generation.
# Claude edits this between check-ins to steer strategy; no restart needed.
# Set ENABLED=0 to pause the loop cleanly (finishes nothing new, idles).

ENABLED=1

# games per generation (bigger = the restart pool warms up more before it matters)
GAMES=4000000

# freeze stages below N. 3 = train ONLY the top stage (65536/131072 regime),
# lower stages byte-frozen so the early game cannot regress.
FREEZE=3

# probability a game restarts from a pooled board instead of a fresh start,
# and which stage to pull that board from. stage 2 = 32768 boards (plentiful);
# playing forward from them generates the stage-3 experience we want.
RESTART_P=0.6
RESTART_STAGE=2

# per-weight step. "auto" = the binary's default (0.1 spread over tuples).
ALPHA=auto

# seconds to idle between generations, and the production RAM floor (MB).
# If free RAM drops below the floor, training is killed and the loop waits.
GEN_SLEEP=5
RAM_FLOOR_MB=3000
