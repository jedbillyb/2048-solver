# Tunables for evolve.sh - re-read at the start of every generation.
# Claude edits this between check-ins to steer strategy; no restart needed.
# Set ENABLED=0 to pause the loop cleanly (finishes nothing new, idles).

# PAUSED 2026-10-08: 3 gens flat at 65536 0% (training reproduces the known
# flat farm result). Running a depth/endgame-eval diagnostic to confirm the real
# lever before spending compute. Re-enable once the strategy is re-pointed.
ENABLED=0

# games per generation. ~93 games/s here (restart games play ~10k moves to
# game-over), so 4M = ~12h/gen, far too slow for a tight hill-climb. 250k is
# ~45min/gen: the restart pool still fills in tens of thousands of games
# (25% of games reach 32768), so top-stage experience is plentiful per gen.
GAMES=250000

# freeze stages below N. stage(b)=max_rank-13: stage2=32768 boards, stage3=65536+.
# Reaching 65536 FROM a 32768 board is a STAGE-2 decision. freeze 3 trained only
# stage 3 and moved the metric 0% (from the hardest 32768 boards the net never
# even reaches a stage-3 board, so stage-3 weights never fire). freeze 2 trains
# stages 2 AND 3 (the 32768->65536->131072 regime) while the early game (stages
# 0,1 = reaching 32768) stays byte-frozen, so no catastrophic forgetting.
FREEZE=2

# probability a game restarts from a pooled board instead of a fresh start,
# and which stage to pull that board from. stage 2 = 32768 boards (plentiful);
# playing forward from them generates the stage-3 experience we want.
RESTART_P=0.6
RESTART_STAGE=2

# per-weight step. "auto" = the binary's default (0.1 spread over tuples).
ALPHA=auto

# seconds to idle between generations, and the production RAM floor (MB).
# If free RAM drops below the floor, training is killed and the loop waits.
GEN_SLEEP=5
RAM_FLOOR_MB=3000
